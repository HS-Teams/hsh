#!/usr/bin/env bash

set -e
set -u
set -o pipefail

REPOSITORY_ROOT=$(cd "$(dirname "$0")/../.." && pwd)
GATE_SCRIPT="${REPOSITORY_ROOT}/scripts/check-distribution-readiness.sh"
TEST_CHECKLIST=$(mktemp "${TMPDIR:-/tmp}/hsh-distribution-checklist.XXXXXX")

cleanup() {
    rm -f "${TEST_CHECKLIST}"
}

trap cleanup EXIT

write_approved_checklist() {
    cat > "${TEST_CHECKLIST}" <<'EOF'
Gate status: APPROVED
Release identifier: 1.0.0
Source commit: 0123456789012345678901234567890123456789
Artifact manifest: release/artifacts.sha256
Corresponding source location: https://example.invalid/hsh-source.tar.xz
Dependency/license report: release/dependencies.txt
Release owner: Release Owner
Legal reviewer: Counsel, review-123
Approval date: 2026-09-11
- [x] `SCOPE-CLASSIFIED`
- [x] `SOURCE-PROVENANCE`
- [x] `MODIFICATIONS-RECORDED`
- [x] `COPYRIGHTS-PRESERVED`
- [x] `GPL-COPY-INCLUDED`
- [x] `CORRESPONDING-SOURCE-COMPLETE`
- [x] `SOURCE-ACCESS-PAIRED`
- [x] `INSTALLATION-INFORMATION-REVIEWED`
- [x] `NO-FURTHER-RESTRICTIONS`
- [x] `DEPENDENCIES-INVENTORIED`
- [x] `THIRD-PARTY-NOTICES-INCLUDED`
- [x] `RUST-AND-SDK-LICENSES-REVIEWED`
- [x] `PROCESS-BOUNDARY-NOT-ASSUMED`
- [x] `ARTIFACTS-HASHED`
- [x] `SOURCE-MATCHES-BINARY`
- [x] `LEGAL-REVIEW-APPROVED`
- [x] `RELEASE-OWNER-APPROVED`
EOF
}

expect_failure() {
    local description

    description=$1
    if "${GATE_SCRIPT}" "${TEST_CHECKLIST}" >/dev/null 2>&1; then
        printf 'FAIL: expected rejection for %s\n' "${description}" >&2
        exit 1
    fi
}

write_approved_checklist
"${GATE_SCRIPT}" "${TEST_CHECKLIST}" >/dev/null

write_approved_checklist
sed -i.bak 's/Gate status: APPROVED/Gate status: PENDING/' "${TEST_CHECKLIST}"
rm -f "${TEST_CHECKLIST}.bak"
expect_failure "pending gate status"

write_approved_checklist
sed -i.bak 's/Release identifier: 1.0.0/Release identifier: TBD/' "${TEST_CHECKLIST}"
rm -f "${TEST_CHECKLIST}.bak"
expect_failure "placeholder metadata"

write_approved_checklist
# Single quotes keep the Markdown backticks literal; they are not shell syntax.
# shellcheck disable=SC2016
sed -i.bak 's/- \[x\] `GPL-COPY-INCLUDED`/- [ ] `GPL-COPY-INCLUDED`/' "${TEST_CHECKLIST}"
rm -f "${TEST_CHECKLIST}.bak"
expect_failure "unchecked required item"

printf 'distribution readiness gate tests: PASS\n'
